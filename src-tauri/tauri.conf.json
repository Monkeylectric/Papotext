{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papotext",
  "version": "0.1.0",
  "identifier": "io.local.papotext",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "papotext",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "models/ggml-small.bin": "models/ggml-small.bin"
    },
    "macOS": {
        "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://papotext.com/update/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDMjBFRDMwNDBGRTQ3MzEKUldReFIvNUFNTzBnM0lNalIxVW1aeGx4N0tVL2UzYmVVbkZxbEd5VjVJVS8zaTNjQy9BY1E5WnoK"
    }
  }
}